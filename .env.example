OPENAI_API_KEY="your_openai_api_key_here"

# Local Qwen OpenAI-compatible generation server (qwen-llm / vLLM)
OPENAI_BASE_URL="http://127.0.0.1:8000/v1"
OPENAI_MODEL_NAME="Qwen/Qwen3.5-0.8B"
QWEN_LLM_URL="http://127.0.0.1:8000"

# Local embedding server — model 1 (primary)
QWEN_SERVER_URL="http://127.0.0.1:8001"
QWEN_EMBED_URL="http://127.0.0.1:8001"
LOCAL_EMBEDDING_MODEL_NAME="Qwen/Qwen3-Embedding-0.6B"

# Local embedding server — model 2 (optional, better model for A/B comparison)
# Run on port 8002: vllm serve Qwen/Qwen3-Embedding-4B --port 8002 --task embed
QWEN_EMBED_URL2="http://127.0.0.1:8002"
LOCAL_EMBEDDING_MODEL_NAME2="Qwen/Qwen3-Embedding-4B"

# Optional planner server override when GRAPH_PLANNER_BACKEND=qwen_server
# If unset, planner falls back to QWEN_LLM_URL then QWEN_SERVER_URL.
QWEN_PLANNER_URL="http://127.0.0.1:8000"

# Graph retrieval semantic mode
GRAPH_SEMANTIC_BACKEND="qwen_server"

# Optional Hugging Face token for gated model pulls inside Docker
HUGGING_FACE_HUB_TOKEN=""
